# Copy to .env, fill in (no spaces around =), then load it into your shell:

# AIO tracing (leave empty to run without tracing)
# Your AIO address plus /aio, for example https://mytenant.example.acceldata.app/aio
AIO_ENDPOINT=
# Your tenant ID: usually the first part of your AIO host name ("mytenant" above).
AIO_TENANT_ID=
AIO_ACCESS_KEY=
AIO_SECRET_KEY=
# The ID of the AIO project the traces go to. Create the project in AIO first (any name), then copy its ID here.
AIO_PROJECT_ID=
